datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
  SENIOR_MANAGER
  PROJECT_MANAGER
  DEPARTMENT_MANAGER
  HR
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DocumentType {
  PAYSLIP
  INSURANCE
  AGREEMENT
  PF
  PERSONAL
  EDUCATIONAL
  OTHER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  REOPENED
}

enum SubmissionStatus {
  PENDING_REVIEW
  APPROVED
  CHANGES_REQUESTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

model Attendance {
  id        String           @id @default(uuid())
  userId    String
  date      DateTime
  status    AttendanceStatus
  checkIn   DateTime?
  checkOut  DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id])
}

model Department {
  id            String              @id @default(uuid())
  name          String              @unique
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  users         User[]              @relation("DepartmentUsers")
  leaves        Leave[]
  announcements Announcement[]
  projects      ProjectDepartment[]
  teams         Team[]
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  TERMINATED
  PENDING_TERMINATION
}

model Project {
  id          String        @id @default(uuid())
  title       String
  description String?
  deadline    DateTime?
  status      ProjectStatus @default(ACTIVE)

  seniorManagerId  String?
  projectManagerId String?
  seniorManager    User?   @relation("SeniorManagerProjects", fields: [seniorManagerId], references: [id])
  projectManager   User?   @relation("ProjectManagerProjects", fields: [projectManagerId], references: [id])

  departments        ProjectDepartment[]
  
  // Attachments
  fileUrl      String?
  storedFileId String?
  storedFile   StoredFile? @relation(fields: [storedFileId], references: [id])
  teams              Team[]
  reports            ProjectReport[]
  terminationRequest ProjectTerminationRequest?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectDepartment {
  id           String     @id @default(uuid())
  projectId    String
  departmentId String
  project      Project    @relation(fields: [projectId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])
  assignedAt   DateTime   @default(now())

  @@unique([projectId, departmentId])
}

model Team {
  id              String        @id @default(uuid())
  name            String
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id])
  departmentId    String
  department      Department    @relation(fields: [departmentId], references: [id])
  createdByUserId String
  members         TeamMember[]
  messages        TeamMessage[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum TeamRole {
  LEAD
  MEMBER
}

model TeamMember {
  id         String   @id @default(uuid())
  teamId     String
  employeeId String
  role       TeamRole @default(MEMBER)
  team       Team     @relation(fields: [teamId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([teamId, employeeId])
}

model TeamMessage {
  id            String   @id @default(uuid())
  teamId        String
  senderUserId  String
  body          String
  attachmentUrl String?
  createdAt     DateTime @default(now())
  team          Team     @relation(fields: [teamId], references: [id])
  sender        User     @relation(fields: [senderUserId], references: [id])
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  role          Role           @default(EMPLOYEE)
  departmentId  String?
  department    Department?    @relation(fields: [departmentId], references: [id], name: "DepartmentUsers")
  employee      Employee?
  notifications Notification[]
  cabTickets    CabTicket[]

  uploadedDocuments          EmployeeDocument[]
  assignedTasks              Task[]
  reviewedSubmissions        TaskSubmission[]
  createdAnnouncements       Announcement[]
  resolvedTickets            SupportTicket[]
  attendance                 Attendance[]
  reviewedPerformanceReports PerformanceReport[]

  // Communication Relations
  participatedConversations ConversationParticipant[]
  sentMessages              Message[]
  callsMade                 CallSession[]             @relation("CallsMade")
  callsReceived             CallSession[]             @relation("CallsReceived")
  sentTeamMessages          TeamMessage[]

  // Project Management Relations
  seniorManagerProjects  Project[]       @relation("SeniorManagerProjects")
  projectManagerProjects Project[]       @relation("ProjectManagerProjects")
  verifiedReportsL1      ProjectReport[] @relation("ReportVerifierL1")
  verifiedReportsL2      ProjectReport[] @relation("ReportVerifierL2")
  financeReports         FinanceReport[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt


  uploadedFiles StoredFile[]
  profileImage  String?
}

enum FileCategory {
  TASK_ATTACHMENT
  TASK_SUBMISSION
  DAILY_REPORT
  PROFILE_PICTURE
  ANNOUNCEMENT
  EMPLOYEE_DOCUMENT
  SUPPORT_TICKET
  CHAT_MEDIA
  OTHER
}

model StoredFile {
  id        String       @id @default(uuid())
  filename  String
  mimeType  String
  data      Bytes?
  url       String?
  size      Int
  category  FileCategory @default(OTHER)
  createdAt DateTime     @default(now())

  uploadedByUserId String
  uploadedBy       User   @relation(fields: [uploadedByUserId], references: [id])

  // Relations to consumers
  documents          EmployeeDocument[]
  submissions        TaskSubmission[]
  resources          LearningResource[]
  financeReports     FinanceReport[]
  projects           Project[]
  performanceReports PerformanceReport[]
  tasks              Task[]
}

model Employee {
  id               String    @id @default(uuid())
  userId           String    @unique
  firstName        String
  lastName         String
  phone            String?
  address          String?
  permanentAddress String?
  emergencyContact String?
  jobTitle         String?
  joinDate         DateTime?
  salary           Float?
  managerId        String?
  gender           Gender
  dob              DateTime?
  bloodGroup       String?

  user               User                     @relation(fields: [userId], references: [id])
  leaves             Leave[]
  documents          EmployeeDocument[]
  tasks              Task[]                   @relation("EmployeeTasks")
  submissions        TaskSubmission[]
  performanceReports PerformanceReport[]
  tickets            SupportTicket[]
  dailyReports       TaskDailyReport[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  leaveBalances      LeaveTokenBalance[]
  teamMemberships    TeamMember[]
  // Utilities
  cabAssignments     CabPassengerAssignment[]
  locationLogs       EmployeeLocationLog[]
  foodBalances       FoodTokenBalance[]
  foodTransactions   FoodTransaction[]
  learningResources  LearningResource[]
  MeetingAttendance  MeetingAttendance[]
  sosIncidents       SosIncident[]
  efficiencyRecords  EfficiencyRecord[]
  shiftEndTime       String?                  @default("18:00") // Format HH:mm
  FoodOrder          FoodOrder[]
  ProjectReport      ProjectReport[]
}

model LeaveTokenBalance {
  id         String   @id @default(uuid())
  employeeId String
  year       Int
  type       String
  total      Float
  used       Float    @default(0)
  remaining  Float
  employee   Employee @relation(fields: [employeeId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, year, type])
}

model Leave {
  id             String      @id @default(uuid())
  employeeId     String
  departmentId   String
  type           String
  reason         String?
  startDate      DateTime
  endDate        DateTime
  status         LeaveStatus @default(PENDING)
  isAutoApproved Boolean     @default(false)
  requestedAt    DateTime    @default(now())
  respondedAt    DateTime?
  respondedBy    String?
  employee       Employee    @relation(fields: [employeeId], references: [id])
  department     Department  @relation(fields: [departmentId], references: [id])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  title       String?
  body        String?
  type        String   @default("INFO")
  referenceId String?
  payload     Json?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model EmployeeDocument {
  id               String       @id @default(uuid())
  employeeId       String
  type             DocumentType
  title            String
  fileUrl          String?
  storedFileId     String?
  storedFile       StoredFile?  @relation(fields: [storedFileId], references: [id])
  uploadedByUserId String
  createdAt        DateTime     @default(now())
  employee         Employee     @relation(fields: [employeeId], references: [id])
  uploadedBy       User         @relation(fields: [uploadedByUserId], references: [id])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id               String            @id @default(uuid())
  employeeId       String
  assignedByUserId String
  title            String
  description      String?
  status           TaskStatus        @default(PENDING)
  priority         TaskPriority      @default(MEDIUM)
  dueDate          DateTime?
  fileUrl          String?
  storedFileId     String?
  storedFile       StoredFile?       @relation(fields: [storedFileId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  employee         Employee          @relation("EmployeeTasks", fields: [employeeId], references: [id])
  assignedBy       User              @relation(fields: [assignedByUserId], references: [id])
  submissions      TaskSubmission[]
  dailyReports     TaskDailyReport[]
}

model TaskDailyReport {
  id          String   @id @default(uuid())
  taskId      String
  employeeId  String
  progress    Int // 0-100
  hoursSpent  Float
  description String
  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  task     Task     @relation(fields: [taskId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
}

model TaskSubmission {
  id               String           @id @default(uuid())
  taskId           String
  employeeId       String
  content          String
  fileUrl          String?
  storedFileId     String?
  storedFile       StoredFile?      @relation(fields: [storedFileId], references: [id])
  submittedAt      DateTime         @default(now())
  reviewedByUserId String?
  reviewComment    String?
  status           SubmissionStatus @default(PENDING_REVIEW)
  task             Task             @relation(fields: [taskId], references: [id])
  employee         Employee         @relation(fields: [employeeId], references: [id])
  reviewedBy       User?            @relation(fields: [reviewedByUserId], references: [id])
}

model PerformanceReport {
  id           String      @id @default(uuid())
  employeeId   String
  title        String
  projectName  String
  periodStart  DateTime
  periodEnd    DateTime
  fileUrl      String?
  storedFileId String?
  storedFile   StoredFile? @relation(fields: [storedFileId], references: [id])
  rating       Float?
  feedback     String?
  reviewerId   String?

  // New fields for deadlines
  dueDate        DateTime?
  submissionDate DateTime?
  status         SubmissionStatus @default(PENDING_REVIEW)

  createdAt DateTime @default(now())
  reviewer  User?    @relation(fields: [reviewerId], references: [id])
  employee  Employee @relation(fields: [employeeId], references: [id])
}

model Meeting {
  id          String              @id @default(uuid())
  title       String
  description String?
  scheduledAt DateTime
  duration    Int // minutes
  type        String // WEBINAR, DISCUSSION, etc.
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  attendees   MeetingAttendance[]
}

model MeetingAttendance {
  id              String    @id @default(uuid())
  meetingId       String
  employeeId      String
  attended        Boolean   @default(false)
  reportSubmitted Boolean   @default(false)
  joinedAt        DateTime?
  createdAt       DateTime  @default(now())

  meeting  Meeting  @relation(fields: [meetingId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([meetingId, employeeId])
}

model Announcement {
  id              String      @id @default(uuid())
  title           String
  body            String
  departmentId    String?
  mediaUrl        String?
  mediaType       String?
  createdByUserId String
  createdAt       DateTime    @default(now())
  department      Department? @relation(fields: [departmentId], references: [id])
  createdBy       User        @relation(fields: [createdByUserId], references: [id])
}

model SupportTicket {
  id               String       @id @default(uuid())
  employeeId       String
  subject          String
  description      String
  attachmentUrl    String?
  status           TicketStatus @default(OPEN)
  priority         String       @default("MEDIUM")
  category         String       @default("OTHER")
  resolution       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  resolvedAt       DateTime?
  resolvedByUserId String?
  employee         Employee     @relation(fields: [employeeId], references: [id])
  resolvedBy       User?        @relation(fields: [resolvedByUserId], references: [id])
}

model Conversation {
  id           String                    @id @default(uuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
  calls        CallSession[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderUserId   String
  body           String
  fileUrl        String?
  fileType       String?
  storedFileId   String?
  createdAt      DateTime     @default(now())
  readAt         DateTime?
  conversation   Conversation          @relation(fields: [conversationId], references: [id])
  sender         User                  @relation(fields: [senderUserId], references: [id])
  
  // Edit History
  isEdited       Boolean               @default(false)
  editedAt       DateTime?
  editHistory    MessageEditHistory[]
}

model MessageEditHistory {
  id        String   @id @default(uuid())
  messageId String
  oldBody   String
  editedAt  DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id])
}

enum CallStatus {
  RINGING
  IN_PROGRESS
  ENDED
  MISSED
  REJECTED
}

model CallSession {
  id             String     @id @default(uuid())
  conversationId String?
  callerUserId   String
  calleeUserId   String
  status         CallStatus @default(RINGING)
  startedAt      DateTime?
  endedAt        DateTime?
  duration       Int?       @default(0)
  recordingUrl   String?
  reason         String?
  createdAt      DateTime   @default(now())

  caller       User          @relation("CallsMade", fields: [callerUserId], references: [id])
  callee       User          @relation("CallsReceived", fields: [calleeUserId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
}

// ========================
// TRANSPORT SUBSYSTEM
// ========================

enum ShiftType {
  MORNING
  EVENING
  NIGHT
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model Vehicle {
  id                 String        @id @default(uuid())
  registrationNumber String        @unique
  capacity           Int // e.g. 10
  status             VehicleStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  trips              CabTrip[]
  sosIncidents       SosIncident[]
}

model Driver {
  id           String        @id @default(uuid())
  name         String
  phone        String
  licenseNo    String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  trips        CabTrip[]
  sosIncidents SosIncident[]
}

model Route {
  id           String    @id @default(uuid())
  name         String
  description  String?
  pickupPoints String[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  trips        CabTrip[]
}

model CabTicket {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  date      DateTime
  reason    String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model CabTrip {
  id           String                   @id @default(uuid())
  date         DateTime
  shift        ShiftType
  vehicleId    String
  driverId     String
  routeId      String
  departmentId String?
  vehicle      Vehicle                  @relation(fields: [vehicleId], references: [id])
  driver       Driver                   @relation(fields: [driverId], references: [id])
  route        Route                    @relation(fields: [routeId], references: [id])
  passengers   CabPassengerAssignment[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  sosIncidents SosIncident[]
}

model CabPassengerAssignment {
  id          String   @id @default(uuid())
  cabTripId   String
  employeeId  String
  pickupPoint String
  dropPoint   String
  pickupTime  DateTime
  dropTime    DateTime
  createdAt   DateTime @default(now())
  cabTrip     CabTrip  @relation(fields: [cabTripId], references: [id])
  employee    Employee @relation(fields: [employeeId], references: [id])
}

model EmployeeLocationLog {
  id         String   @id @default(uuid())
  employeeId String
  latitude   Float
  longitude  Float
  capturedAt DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id])
}

// ========================
// FOOD / PANTRY SUBSYSTEM
// ========================

enum FoodTransactionType {
  TOKEN
  USE_EXTRA
}

model FoodTokenBalance {
  id          String   @id @default(uuid())
  employeeId  String
  year        Int
  month       Int
  totalTokens Int
  usedTokens  Int      @default(0)
  employee    Employee @relation(fields: [employeeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, year, month])
}

model FoodTransaction {
  id            String              @id @default(uuid())
  employeeId    String
  tokensUsed    Int                 @default(0)
  amountCharged Float               @default(0)
  type          FoodTransactionType
  description   String?
  createdAt     DateTime            @default(now())
  employee      Employee            @relation(fields: [employeeId], references: [id])
}

model FoodItem {
  id          String          @id @default(uuid())
  name        String
  description String?
  price       Float
  isAvailable Boolean         @default(true)
  category    String          @default("MEAL") // MEAL, SNACK, DRINK
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  orderItems  FoodOrderItem[]
}

enum FoodOrderStatus {
  PENDING
  APPROVED
  REJECTED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

model FoodOrder {
  id            String          @id @default(uuid())
  employeeId    String
  totalAmount   Float
  status        FoodOrderStatus @default(PENDING)
  floor         String?
  seatNumber    String?
  paymentStatus String          @default("PENDING") // PENDING, PAID
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  employee Employee        @relation(fields: [employeeId], references: [id])
  items    FoodOrderItem[]
}

model FoodOrderItem {
  id         String @id @default(uuid())
  orderId    String
  foodItemId String
  quantity   Int
  price      Float

  order    FoodOrder @relation(fields: [orderId], references: [id])
  foodItem FoodItem  @relation(fields: [foodItemId], references: [id])
}

// ========================
// SELF DEVELOPMENT
// ========================

enum ResourceType {
  COURSE
  WEBINAR
  CERTIFICATION
  BOOK
  OTHER
}

enum ResourceStatus {
  ASSIGNED
  REQUESTED
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
}

model LearningResource {
  id             String      @id @default(uuid())
  employeeId     String
  title          String
  description    String
  type           String
  url            String?
  storedFileId   String?
  storedFile     StoredFile? @relation(fields: [storedFileId], references: [id])
  cost           Float?
  justification  String?
  status         String
  adminComment   String?
  certificateUrl String?
  tokenId        String?     @unique
  paymentUrl     String?
  paymentStatus  String      @default("PENDING")
  createdAt      DateTime    @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}

// ========================
// CALENDAR SUBSYSTEM
// ========================

enum CalendarEventType {
  HOLIDAY
  EVENT
  SHUTDOWN
  WORK_DAY
}

model CalendarEvent {
  id          String            @id @default(uuid())
  title       String
  description String?
  date        DateTime          @unique
  type        CalendarEventType @default(HOLIDAY)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

// ========================
// SOS SUBSYSTEM
// ========================

enum SosStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  FALSE_ALARM
}

enum SosSource {
  WEB
  MOBILE
}

model SosIncident {
  id          String    @id @default(uuid())
  employeeId  String
  cabTripId   String?
  vehicleId   String?
  driverId    String?
  status      SosStatus @default(ACTIVE)
  source      SosSource @default(WEB)
  message     String?
  initialLat  Float?
  initialLong Float?
  lastLat     Float?
  lastLong    Float?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  cabTrip  CabTrip? @relation(fields: [cabTripId], references: [id])
  vehicle  Vehicle? @relation(fields: [vehicleId], references: [id])
  driver   Driver?  @relation(fields: [driverId], references: [id])

  locationLogs SosLocationLog[]
}

model SosLocationLog {
  id            String      @id @default(uuid())
  sosIncidentId String
  latitude      Float
  longitude     Float
  capturedAt    DateTime    @default(now())
  sosIncident   SosIncident @relation(fields: [sosIncidentId], references: [id])
}

enum EfficiencyPeriod {
  WEEKLY
  MONTHLY
  YEARLY
}

model EfficiencyRecord {
  id         String           @id @default(uuid())
  employeeId String
  period     EfficiencyPeriod
  startDate  DateTime
  endDate    DateTime
  score      Float
  breakdown  Json
  generatedAt DateTime        @default(now())
  employee   Employee         @relation(fields: [employeeId], references: [id])
}

enum ReportStatus {
  PENDING
  VERIFIED_L1
  VERIFIED_L2
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model ProjectReport {
  id          String       @id @default(uuid())
  projectId   String
  employeeId  String
  title       String
  content     String
  fileUrl     String?
  status      ReportStatus @default(PENDING)
  submittedAt DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  verifiedByL1UserId String? // Senior Manager
  verifiedByL2UserId String? // Project Manager
  verifiedByL1Id     String? // Alias for code compatibility if needed, or stick to one. Code uses verifiedByL1Id.
  verifiedByL2Id     String? // Alias for code compatibility if needed.

  l1Status  ReportStatus @default(PENDING)
  l2Status  ReportStatus @default(PENDING)
  l1Comment String?
  l2Comment String?

  project    Project  @relation(fields: [projectId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id])
  verifierL1 User?    @relation("ReportVerifierL1", fields: [verifiedByL1UserId], references: [id])
  verifierL2 User?    @relation("ReportVerifierL2", fields: [verifiedByL2UserId], references: [id])
}

enum TerminationStatus {
  PENDING
  PENDING_APPROVAL
  PENDING_CEO
  APPROVED
  APPROVED_L1 // Approved by Project Manager
  APPROVED_L2 // Approved by Senior Manager
  APPROVED_HR // Approved by HR (Final)
  REJECTED
}

model ProjectTerminationRequest {
  id          String            @id @default(uuid())
  projectId   String            @unique
  reason      String
  status      TerminationStatus @default(PENDING)
  requestedAt DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Approval flags expected by code
  teamLeadApproved Boolean @default(false)
  pmApproved       Boolean @default(false)
  seniorPmApproved Boolean @default(false)
  hrApproved       Boolean @default(false)
  ceoApproved      Boolean @default(false)

  // Report fields expected by code
  descriptionReport String?
  isOnline          Boolean?
  proofUrl          String?
  discussionReport  String?


  pkStatus TerminationStatus @default(PENDING) // Project Manager Status
  smStatus TerminationStatus @default(PENDING) // Senior Manager Status
  hrStatus TerminationStatus @default(PENDING) // HR Status

  project Project @relation(fields: [projectId], references: [id])
}

model FinanceReport {
  id              String      @id @default(uuid())
  title           String
  type            String
  fileUrl         String?
  storedFileId    String?
  periodStart     DateTime
  periodEnd       DateTime
  createdByUserId String
  createdAt       DateTime    @default(now())
  createdBy       User        @relation(fields: [createdByUserId], references: [id])
  storedFile      StoredFile? @relation(fields: [storedFileId], references: [id])
}
